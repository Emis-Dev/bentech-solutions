      "css": ".ds-field-wrap{background:var(--navy,#09141e);color:#fff;padding:22px;max-width:340px;font-family:Manrope,sans-serif}.ds-label{display:block;font-size:12px;font-weight:700;line-height:1.7;margin-bottom:6px}.ds-input{width:100%;min-width:0;min-height:47px;background:#f8fbff;color:var(--ink,#111f2d);border:1px solid #7b9ab0;border-radius:5px;padding:11px 12px;font:400 13px/1.7 Manrope,sans-serif;caret-color:#007cc7}.ds-input::placeholder{color:#536474}.ds-input:focus-visible{outline:3px solid var(--bright,#079ef3);outline-offset:5px;outline-offset:2px}.ds-input:user-invalid{border:2px solid #ff9e8f}.ds-input:disabled{opacity:.65}"
